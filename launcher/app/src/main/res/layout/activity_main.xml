<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: the place's name, its country and what it is about, positioned above the dock in code.
         The width is capped in code to a share of the space between the side paddings, so the
         description wraps in a column instead of running the width of the screen. -->
    <LinearLayout
        android:id="@+id/heroShelf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="55dp"
        android:orientation="vertical"
        android:alpha="0">

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="40sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 300"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.75"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- The country close under the name, and the description a little further below it. -->
        <TextView
            android:id="@+id/heroWhere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-1.5dp"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/heroDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9.5dp"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 300"
            android:lineSpacingExtra="2dp"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topRightBlock"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <!-- The header texts use gravity left, not start: the launcher lays out left to right
                     (no supportsRtl), and with start a right-to-left script such as Arabic would move to the
                     right edge of these full-width lines instead of staying under the clock. -->
                <!-- The clock keeps the place it had under the greeting that used to sit above it. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="52sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 300"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false" />

                    <!-- AM/PM over the date, both starting at the same line: the date on the digits'
                         baseline, AM/PM resting halfway between the top of the digits and the date (placed in
                         code). -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp">

                        <TextClock
                            android:id="@+id/ampm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:includeFontPadding="false"
                            android:format12Hour="a"
                            android:format24Hour=""
                            android:textColor="#B3FFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true" />

                        <LinearLayout
                            android:id="@+id/dateBlock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:orientation="vertical">

                            <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
                            <TextView
                                android:id="@+id/shamsiDate"
                                android:gravity="left"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:textColor="#E6FFFFFF"
                                android:textSize="17sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 400"
                                android:letterSpacing="0.02"
                                android:includeFontPadding="false"
                                android:visibility="gone" />

                            <TextClock
                                android:id="@+id/date"
                                android:gravity="left"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:format12Hour="@string/date_format"
                                android:format24Hour="@string/date_format"
                                android:textColor="#A6FFFFFF"
                                android:textSize="14sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 400"
                                android:letterSpacing="0.14"
                                android:textAllCaps="true" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topRightBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="vertical"
                android:gravity="end">

                <LinearLayout
                    android:id="@+id/topButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnInputs"
                        style="@style/TopMenuButton"
                        android:text="@string/inputs"
                        android:drawableStart="@drawable/ic_input"
                        android:nextFocusDown="@+id/grid" />

                    <TextView
                        android:id="@+id/btnWifi"
                        style="@style/TopMenuButton"
                        android:maxWidth="180dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/wifi"
                        android:drawableStart="@drawable/ic_wifi"
                        android:nextFocusDown="@+id/grid" />

                    <TextView
                        android:id="@+id/btnSettings"
                        style="@style/TopMenuButton"
                        android:layout_width="42dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="0dp"
                        android:drawablePadding="0dp"
                        android:contentDescription="@string/settings"
                        android:drawableStart="@drawable/ic_settings"
                        android:nextFocusDown="@+id/grid" />
                </LinearLayout>

                <!-- Waktu Solat JAKIM (Bawah Wi-Fi Sebelah Kanan) -->
                <LinearLayout
                    android:id="@+id/prayerCard"
                    android:layout_width="400dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_prayer_card"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="11dp"
                    android:layout_marginTop="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/prayerHeaderTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🕌 SOLAT • KDH01"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:letterSpacing="0.06"
                            android:includeFontPadding="false"
                            android:textAllCaps="true" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/prayerNextText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Zohor 1:05 pm (45m lagi)"
                            android:textColor="#FFFFD54F"
                            android:textSize="13sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Subuh -->
                        <LinearLayout
                            android:id="@+id/pillSubuh"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_prayer_pill_inactive"
                            android:paddingTop="5dp"
                            android:paddingBottom="6dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SUBUH"
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 500"
                                android:includeFontPadding="false" />
                            <TextView
                                android:id="@+id/timeSubuh"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="5:55a"
                                android:textColor="#FFFFFFFF"
                                android:textSize="13sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 600"
                                android:includeFontPadding="false" />
                        </LinearLayout>

                        <!-- Zohor (WHITE text, same as others) -->
                        <LinearLayout
                            android:id="@+id/pillZohor"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_prayer_pill_inactive"
                            android:paddingTop="5dp"
                            android:paddingBottom="6dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ZOHOR"
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 500"
                                android:includeFontPadding="false" />
                            <TextView
                                android:id="@+id/timeZohor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="1:05p"
                                android:textColor="#FFFFFFFF"
                                android:textSize="13sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 600"
                                android:includeFontPadding="false" />
                        </LinearLayout>

                        <!-- Asar -->
                        <LinearLayout
                            android:id="@+id/pillAsar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_prayer_pill_inactive"
                            android:paddingTop="5dp"
                            android:paddingBottom="6dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ASAR"
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 500"
                                android:includeFontPadding="false" />
                            <TextView
                                android:id="@+id/timeAsar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="4:24p"
                                android:textColor="#FFFFFFFF"
                                android:textSize="13sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 600"
                                android:includeFontPadding="false" />
                        </LinearLayout>

                        <!-- Maghrib -->
                        <LinearLayout
                            android:id="@+id/pillMaghrib"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_prayer_pill_inactive"
                            android:paddingTop="5dp"
                            android:paddingBottom="6dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MAGHRIB"
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 500"
                                android:includeFontPadding="false" />
                            <TextView
                                android:id="@+id/timeMaghrib"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="7:03p"
                                android:textColor="#FFFFFFFF"
                                android:textSize="13sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 600"
                                android:includeFontPadding="false" />
                        </LinearLayout>

                        <!-- Isyak -->
                        <LinearLayout
                            android:id="@+id/pillIsyak"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_prayer_pill_inactive"
                            android:paddingTop="5dp"
                            android:paddingBottom="6dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ISYAK"
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 500"
                                android:includeFontPadding="false" />
                            <TextView
                                android:id="@+id/timeIsyak"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="8:13p"
                                android:textColor="#FFFFFFFF"
                                android:textSize="13sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 600"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Widget Skor Badminton BWF -->
                <LinearLayout
                    android:id="@+id/badmintonCard"
                    android:layout_width="400dp"
                    android:layout_height="148dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_prayer_card"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginTop="6dp"
                    android:visibility="gone">

                    <!-- Header: Tournament Name + Live/Tournament Badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/bwfHeaderTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🏸 BWF WORLD TOUR"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:letterSpacing="0.04"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/bwfHeaderBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="HARI INI"
                            android:textColor="#FF80CBC4"
                            android:textSize="11sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:letterSpacing="0.06"
                            android:includeFontPadding="false"
                            android:textAllCaps="true" />
                    </LinearLayout>

                    <!-- Match 1 -->
                    <LinearLayout
                        android:id="@+id/bwfMatch1Layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/bwfCat1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="[MS]"
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 600"
                                android:includeFontPadding="false" />

                            <TextView
                                android:id="@+id/bwfStatus1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="JAM 9:00 PM"
                                android:textColor="#FFFFD54F"
                                android:textSize="11sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 600"
                                android:includeFontPadding="false" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/bwfSets1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2 - 1"
                                android:textColor="#FFFFFFFF"
                                android:textSize="13sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 700"
                                android:includeFontPadding="false"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/bwfPlayers1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Popov T. J. vs Sen L."
                            android:textColor="#FFFFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/bwfDetail1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="(21-14, 18-21, 21-16)"
                            android:textColor="#B3FFFFFF"
                            android:textSize="11sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 400"
                            android:includeFontPadding="false"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:id="@+id/bwfDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        android:background="#26FFFFFF"
                        android:visibility="gone" />

                    <!-- Match 2 -->
                    <LinearLayout
                        android:id="@+id/bwfMatch2Layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/bwfCat2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="[WS]"
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 600"
                                android:includeFontPadding="false" />

                            <TextView
                                android:id="@+id/bwfStatus2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="JAM 9:10 PM"
                                android:textColor="#FFFFD54F"
                                android:textSize="11sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 600"
                                android:includeFontPadding="false" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/bwfSets2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2 - 0"
                                android:textColor="#FFFFFFFF"
                                android:textSize="13sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 700"
                                android:includeFontPadding="false"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/bwfPlayers2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Kharb A. vs Sindhu P. V."
                            android:textColor="#FFFFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/bwfDetail2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="(21-17, 21-13)"
                            android:textColor="#B3FFFFFF"
                            android:textSize="11sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 400"
                            android:includeFontPadding="false"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <com.gathin.tvhome.FadeTopFrame
            android:id="@+id/gridWrap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </com.gathin.tvhome.FadeTopFrame>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
